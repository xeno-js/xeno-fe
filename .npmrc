# GitHub Packages registry for @mattia-carcione scope
@mattia-carcione:registry=https://npm.pkg.github.com

# Authentication — set GITHUB_TOKEN in your environment or .env.local (never commit the token)
# Generate a token at: https://github.com/settings/tokens (scopes: read:packages, write:packages)
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
