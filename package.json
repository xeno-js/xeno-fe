{
  "name": "@xeno-js/vue",
  "version": "0.1.1",
  "description": "Xeno fontend npm package for vue",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeno-js/xeno-fe.git"
  },
  "bugs": {
    "url": "https://github.com/xeno-js/xeno-fe/issues"
  },
  "homepage": "https://www.xeno-js.it",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config eslint.config.mjs \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint --config eslint.config.mjs \"src/**/*.ts\" --fix --max-warnings=0",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint:fix && npm run test",
    "verify:commit": "npm run lint-staged && npm run test",
    "verify:push": "npm run check",
    "prepare": "husky",
    "prepublishOnly": "npm run check && npm run build",
    "release": "npm run prepublishOnly && npm publish"
  },
  "keywords": [
    "ddd",
    "clean-architecture",
    "core",
    "kernel",
    "domain-driven-design",
    "mediator",
    "event-sourcing",
    "cqrs",
    "repository-pattern",
    "supabase",
    "zod"
  ],
  "author": "Xeno",
  "license": "ISC",
  "engines": {
    "node": ">=20.0.0"
  },
  "peerDependencies": {
    "@sentry/vue": "^10.75.2",
    "@supabase/supabase-js": "^2.117.1",
    "@xeno-js/shared": "^0.1.4",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "@sentry/vue": {
      "optional": true
    },
    "@supabase/supabase-js": {
      "optional": true
    },
    "@xeno-js/shared": {
      "optional": false
    },
    "vue": {
      "optional": false
    },
    "vue-router": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@sentry/vue": "^10.75.2",
    "@supabase/supabase-js": "^2.117.1",
    "@types/pg": "^8.23.1",
    "@vercel/analytics": "^2.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@xeno-js/shared": "^0.1.4",
    "aos": "^2.3.4",
    "axios": "^1.20.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "tsc-alias": "^1.9.5",
    "tsup": "^8.5.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.11",
    "zod": "^4.6.5"
  }
}
